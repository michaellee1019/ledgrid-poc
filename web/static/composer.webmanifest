{
  "name": "Living Wall Preset Composer",
  "short_name": "Wall Composer",
  "description": "Compose and check Living Wall animation presets entirely in your browser.",
  "id": "/composer",
  "start_url": "/composer",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#10110f",
  "theme_color": "#10110f",
  "categories": ["design", "utilities"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/static/icons/composer-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icons/composer.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
